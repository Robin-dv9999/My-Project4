@charset "utf-8";

body { font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; background-color: rgb(240, 242, 245); color: rgb(51, 51, 51); margin: 0px; padding: 0px; }

header { background: linear-gradient(135deg, rgb(30, 60, 114), rgb(42, 82, 152)); color: white; padding: 25px 20px; text-align: center; }

header h1 { margin: 0px; font-size: 24px; }

header p { margin: 5px 0px 0px; color: rgb(208, 216, 239); font-size: 13px; }

.container { max-width: 600px; margin: 20px auto; padding: 0px 15px; }

.card { background: white; padding: 20px; border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.08) 0px 2px 8px; margin-bottom: 20px; }

.card h3 { margin-top: 0px; color: rgb(30, 60, 114); border-bottom: 2px solid rgb(240, 242, 245); padding-bottom: 8px; font-size: 16px; }

.form-group { margin-bottom: 15px; }

label { display: block; margin-bottom: 5px; font-weight: bold; font-size: 13px; color: rgb(85, 85, 85); }

input[type="text"], textarea { width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid rgb(204, 204, 204); border-radius: 6px; font-size: 14px; }

input[type="file"] { font-size: 13px; }

button { width: 100%; padding: 12px; background-color: rgb(40, 167, 69); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 6px; font-size: 16px; font-weight: bold; cursor: pointer; }

button:hover { background-color: rgb(33, 136, 56); }

.post-card { background: white; border-radius: 10px; box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 6px; margin-bottom: 15px; overflow: hidden; border: 1px solid rgb(225, 228, 232); }

.post-header { padding: 12px 15px; font-weight: bold; font-size: 14px; background: rgb(250, 251, 252); border-bottom: 1px solid rgb(225, 228, 232); display: flex; justify-content: space-between; }

.post-time { font-size: 11px; color: rgb(136, 136, 136); font-weight: normal; }

.post-body { padding: 15px; }

.post-body p { margin: 0px 0px 10px; font-size: 14px; color: rgb(68, 68, 68); }

.post-img { width: 100%; max-height: 320px; object-fit: cover; border-radius: 6px; background: rgb(238, 238, 238); }

.placeholder-box { background: rgb(233, 236, 239); height: 140px; display: flex; align-items: center; justify-content: center; color: rgb(108, 117, 125); border-radius: 6px; font-style: italic; font-size: 13px; }
